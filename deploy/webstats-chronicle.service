[Unit]
Description=Observe public sitemap and robots changes for Webstats
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=webstats
Group=webstats
WorkingDirectory=/opt/webstats
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/webstats/.venv/bin/python -m webstats.chronicle --config /etc/webstats/config.toml
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/webstats
ReadWritePaths=/var/lib/webstats
UMask=0027
